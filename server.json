{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.madezmedia/acmi-mcp",
  "description": "Persistent agent memory via ACMI — Profile/Signals/Timeline. 16 tools on Upstash Redis.",
  "version": "1.3.0",
  "repository": {
    "url": "https://github.com/madezmedia/acmi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@madezmedia/acmi-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "UPSTASH_REDIS_REST_URL",
          "description": "Upstash Redis REST URL (https://your-instance.upstash.io)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "UPSTASH_REDIS_REST_TOKEN",
          "description": "Upstash Redis REST token (read-write)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://server.smithery.ai/@madezmediapartners/acmi-mcp/mcp"
    }
  ]
}
